{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/session_start.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
